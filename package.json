{
  "name": "grf-controle-pessoal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --mode preview",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
